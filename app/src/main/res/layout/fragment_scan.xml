<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_scan_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".scan">

    <!-- Preview de CameraX -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/btnUploadNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.example.sftest.ScannerOverlay
        android:id="@+id/scannerOverlay"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView" />

    <!-- Botón para disparar un escaneo puntual -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/btnScanOnce"
        android:layout_width="56dp"
        android:layout_height="56dp"
        app:srcCompat="@drawable/ic_baseline_qr_code_scanner_24"
        app:layout_constraintBottom_toTopOf="@id/btnUploadNow"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:tint="@android:color/white"
        android:contentDescription="Escanear"
        android:elevation="12dp"/>

    <!-- contador de pendientes -->
    <TextView
        android:id="@+id/tvPendingCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="8dp"
        android:text="Pendientes: 0"
        android:textStyle="bold"
        android:background="@drawable/rounded_light_background"
        android:layout_marginTop="12dp"
        app:layout_constraintTop_toTopOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        android:elevation="6dp"/>

    <!-- Card que muestra el resultado del escaneo (inicialmente gone) -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/resultCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/btnUploadNow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_margin="16dp"
        android:visibility="gone"
        app:cardCornerRadius="12dp"
        app:cardElevation="6dp">

        <TextView
            android:id="@+id/tvResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="Resultado"
            android:textSize="16sp" />

    </com.google.android.material.card.MaterialCardView>

    <!-- Botón "Subir ahora" -->
    <Button
        android:id="@+id/btnUploadNow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Subir ahora"
        android:layout_margin="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Vista overlay para permiso bloqueado (ocultable) -->
    <LinearLayout
        android:id="@+id/permissionBlockedView"
        android:orientation="vertical"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#CC000000"
        android:padding="24dp"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/tvPermissionBlockedMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Permiso de cámara bloqueado. Abre Ajustes para habilitarlo."
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginBottom="16dp"/>

        <Button
            android:id="@+id/btnOpenSettings"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Abrir Ajustes"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
